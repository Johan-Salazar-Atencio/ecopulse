# Copia este archivo a ".env" (para ejecucion LOCAL) y rellena con tu conexion real.
# La variable se lee en application.properties -> spring.data.mongodb.uri
#
# En Render (produccion): crea la variable de entorno MONGODB_URI en el servicio.
# NUNCA subas tu ".env" ni tu password al repositorio. El ".gitignore" ya lo excluye.

# Formato Atlas:
# mongodb+srv://TU_USUARIO:TU_PASSWORD@TU_CLUSTER.mongodb.net/ecopulse?retryWrites=true&w=majority
#
# O si usas Mongo local (sin Atlas):
# mongodb://localhost:27017/ecopulse

MONGODB_URI=mongodb://localhost:27017/ecopulse
